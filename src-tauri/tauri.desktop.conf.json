{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RedTerm Desktop",
  "version": "1.7.14",
  "identifier": "com.coderred.redterm.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:desktop",
    "beforeBuildCommand": "bun run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RedTerm Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#1a0f0f",
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 16
        }
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDMUFCMjhBNUNFRjgwNTkKUldSWmdPOWNpcklhbkYzUmFJWWVLZFV5YkFUV1ZOeUZwWFEybnpVOTg3TTEvMGl3TWVTaDdwN00K",
      "endpoints": [
        "https://github.com/coderredlab/RedTerm/releases/latest/download/latest.json"
      ]
    }
  }
}
