{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "allow-exit-application",
    "allow-list-system-fonts",
    "allow-get-runtime-instance-id",
    "allow-get-keyboard-layout-map",
    "allow-check-voice-input-permissions",
    "allow-request-voice-input-permissions",
    "allow-list-voice-input-languages",
    "allow-start-voice-input",
    "allow-stop-voice-input",
    "allow-cancel-voice-input",
    "allow-ssh-connect",
    "allow-ssh-write",
    "allow-ssh-resize",
    "allow-ssh-disconnect",
    "allow-ssh-get-session-output",
    "allow-ssh-get-session-snapshot",
    "allow-ssh-session-exists",
    "allow-ssh-store-session-snapshot",
    "allow-ssh-upload-clipboard-image",
    "allow-ssh-upload-clipboard-image-from-local-path",
    "allow-sftp-list-dir",
    "allow-sftp-read-file",
    "allow-sftp-download-file",
    "allow-sftp-download-to-dir",
    "allow-sftp-home-dir",
    "allow-read-clipboard-text",
    "allow-write-clipboard-text",
    "allow-read-clipboard-image",
    "allow-set-keyboard-visible",
    "allow-set-keep-screen-on",
    "allow-load-connections",
    "allow-ssh-check-host-key",
    "allow-save-connection",
    "allow-delete-uploaded-ssh-key",
    "allow-delete-connection",
    "allow-ssh-trust-host-key",
    "allow-list-known-hosts",
    "allow-delete-known-host",
    "allow-upload-ssh-key"
  ]
}
